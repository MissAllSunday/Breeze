parameters:
  level: 5
  bootstrapFiles:
    - tests/bootstrap.php
  paths:
    - ./Sources
  excludePaths:
    - ./tests
  inferPrivatePropertyTypeFromConstructor: true
  ignoreErrors:
    - '/Function saveDBSettings not found./'
    - '/Function tokenTxtReplace not found./'
    - '/Function create_control_richedit not found./'
